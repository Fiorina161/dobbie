<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- dobby is a standalone project: restore from nuget.org only, not from
         company feeds that require interactive authentication. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
